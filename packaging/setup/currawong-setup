#!/bin/bash
# currawong-setup: first-run wizard. Asks for the gateway hostname, accepted
# domains, the mailbox next hop and trusted relay networks, writes
# /etc/currawong/currawong.toml, checks it with `currawongd --check-config`
# and starts currawongd. Every key it does not write keeps its default; see
# /usr/share/doc/currawong/currawong.example.toml for the full list.
#
# --firstboot (appliance only) also sets the system hostname and the root
# password. The appliance runs it on tty1 until setup is complete.
set -euo pipefail

CONF_DIR=/etc/currawong
CONF="$CONF_DIR/currawong.toml"
MARKER=/var/lib/currawong/.setup-complete
CLAMD_SOCKET=/run/clamav/clamd.ctl
TITLE="Currawong setup"
FIRSTBOOT=0
[ "${1:-}" = "--firstboot" ] && FIRSTBOOT=1

die() {
    echo "currawong-setup: $*" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || die "run as root"
command -v whiptail >/dev/null || die "whiptail is not installed (apt install whiptail)"
command -v currawongd >/dev/null || die "currawongd is not installed"

# ask PROMPT DEFAULT PATTERN: input box, repeated until the answer matches.
ask() {
    local prompt="$1" value="$2" pattern="$3"
    while true; do
        value="$(whiptail --title "$TITLE" --inputbox "$prompt" 12 72 "$value" 3>&1 1>&2 2>&3)" ||
            die "cancelled"
        if [[ "$value" =~ $pattern ]]; then
            printf '%s' "$value"
            return
        fi
        # stdout is captured by the caller, so draw on stderr.
        whiptail --title "$TITLE" --msgbox "That value is not valid. Try again." 8 50 >&2
    done
}

# toml_list "a, b c": prints ["a", "b", "c"]. Callers validate items first.
toml_list() {
    local out="" item
    for item in ${1//,/ }; do
        out="${out:+$out, }\"$item\""
    done
    printf '[%s]' "$out"
}

HOST_RE='^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'
DOMAINS_RE='^[A-Za-z0-9.-]+([ ,]+[A-Za-z0-9.-]+)*$'
HOP_RE='^[A-Za-z0-9.-]+(:[0-9]{1,5})?$'
CIDRS_RE='^[0-9A-Fa-f:.]+/[0-9]{1,3}([ ,]+[0-9A-Fa-f:.]+/[0-9]{1,3})*$'

whiptail --title "$TITLE" --msgbox "Welcome to Currawong.\n\nThis wizard writes $CONF, creates a TLS certificate if you need one, and starts the gateway.\n\nMail content stays on this host. Australian residency mode is on by default." 14 72

current_host="$(hostname -f 2>/dev/null || hostname)"
host="$(ask "Gateway hostname. Used for EHLO, Received headers and Authentication-Results." "$current_host" "$HOST_RE")"
domains="$(ask "Domains this gateway accepts mail for (space or comma separated)." "" "$DOMAINS_RE")"
next_hop="$(ask "Where clean mail is delivered, as host or host:port. For example tenant.mail.protection.outlook.com, aspmx.l.google.com or exchange.corp.example:25." "" "$HOP_RE")"
cidrs="$(ask "Networks allowed to relay outbound mail through the submission ports (CIDRs, space or comma separated)." "10.0.0.0/8" "$CIDRS_RE")"

clamd=""
if [ -S "$CLAMD_SOCKET" ] || systemctl list-unit-files clamav-daemon.service >/dev/null 2>&1; then
    if whiptail --title "$TITLE" --yesno "Scan mail with the local ClamAV daemon ($CLAMD_SOCKET)?\n\nIf clamd is unreachable, mail is deferred rather than delivered unscanned." 12 72; then
        clamd="unix:$CLAMD_SOCKET"
    fi
fi

new_cert=1
if [ -e "$CONF_DIR/cert.pem" ]; then
    whiptail --title "$TITLE" --yesno "A certificate already exists in $CONF_DIR.\n\nReplace it with a new self-signed certificate for $host? Choose No to keep it." 12 72 ||
        new_cert=0
fi

if [ "$FIRSTBOOT" -eq 1 ]; then
    while true; do
        pass1="$(whiptail --title "$TITLE" --passwordbox "Set the root password for the console." 10 60 3>&1 1>&2 2>&3)" || die "cancelled"
        pass2="$(whiptail --title "$TITLE" --passwordbox "Confirm the root password." 10 60 3>&1 1>&2 2>&3)" || die "cancelled"
        if [ -n "$pass1" ] && [ "$pass1" = "$pass2" ]; then
            break
        fi
        whiptail --title "$TITLE" --msgbox "The passwords were empty or did not match." 8 50
    done
fi

domain_list="$(toml_list "$domains")"
tmp="$(mktemp "$CONF_DIR/.currawong.toml.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
{
    echo "# Written by currawong-setup on $(date -u +%Y-%m-%dT%H:%M:%SZ)."
    echo "# Keys not set here keep their defaults. Every key is documented in"
    echo "# /usr/share/doc/currawong/currawong.example.toml."
    echo
    echo "[gateway]"
    echo "hostname = \"$host\""
    echo
    echo "[auth]"
    echo "authserv_id = \"$host\""
    echo
    echo "[domains]"
    echo "accept = $domain_list"
    for domain in ${domains//,/ }; do
        echo
        echo "[[domains.routes]]"
        echo "domain = \"$domain\""
        echo "next_hop = \"$next_hop\""
    done
    echo
    echo "[[relay.tenants]]"
    echo "id = \"default\""
    echo "domains = $domain_list"
    echo "trusted_cidrs = $(toml_list "$cidrs")"
    echo
    echo "[scanner.clamd]"
    echo "address = \"$clamd\""
    echo "required = true"
} >"$tmp"
chgrp currawong "$tmp"
chmod 0640 "$tmp"

if ! out="$(currawongd --config "$tmp" --check-config 2>&1)"; then
    whiptail --title "$TITLE" --msgbox "The configuration was rejected:\n\n$out\n\nNothing was changed." 14 72
    exit 1
fi
mv "$tmp" "$CONF"
trap - EXIT

if [ "$new_cert" -eq 1 ]; then
    (
        umask 0027
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
            -nodes -days 825 -subj "/CN=$host" -addext "subjectAltName=DNS:$host" \
            -keyout "$CONF_DIR/key.pem" -out "$CONF_DIR/cert.pem" >/dev/null 2>&1
    )
    chgrp currawong "$CONF_DIR/key.pem" "$CONF_DIR/cert.pem"
    chmod 0640 "$CONF_DIR/key.pem" "$CONF_DIR/cert.pem"
fi

if [ "$FIRSTBOOT" -eq 1 ]; then
    hostnamectl set-hostname "$host" 2>/dev/null || echo "$host" >/etc/hostname
    printf 'root:%s\n' "$pass1" | chpasswd
    unset pass1 pass2
fi

if [ -n "$clamd" ]; then
    systemctl enable --now clamav-freshclam.service clamav-daemon.service || true
fi
systemctl enable currawongd.service
systemctl restart currawongd.service
touch "$MARKER"

whiptail --title "$TITLE" --msgbox "Currawong is running.\n\nSMTP: 25 (inbound), 587 and 465 (submission)\nHealth: curl http://127.0.0.1:9090/healthz\nConfig: $CONF\n\nReplace $CONF_DIR/cert.pem and key.pem with a CA-issued certificate and run: systemctl reload currawongd" 16 72
