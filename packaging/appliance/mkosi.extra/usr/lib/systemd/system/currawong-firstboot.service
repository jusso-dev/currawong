[Unit]
Description=Currawong first-boot setup
Documentation=https://github.com/jusso-dev/currawong
# Run once, on tty1, before the login prompt. The wizard writes the marker.
ConditionPathExists=!/var/lib/currawong/.setup-complete
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Before=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/currawong-setup --firstboot
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=TERM=linux
# Re-run on failure or cancel, so the box never comes up unconfigured.
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
