#!/bin/sh
# Runs inside the image after packages are installed.
set -e

# The wizard writes the real config, generates the certificate for the real
# hostname and then enables currawongd. Do not start it before that.
systemctl disable currawongd.service
rm -f /etc/currawong/cert.pem /etc/currawong/key.pem

# The wizard runs on the VGA console and the serial console.
systemctl enable currawong-firstboot@tty1.service currawong-firstboot@ttyS0.service
systemctl enable systemd-networkd.service systemd-resolved.service \
    systemd-timesyncd.service nftables.service

# No password logins until the wizard sets one. No SSH server is installed.
passwd -l root
